# ---------------------------------------------------------------------------
# 复制本文件为 .env 后填写：Windows PowerShell 用
#     Copy-Item .env.example .env
# macOS / Linux 用
#     cp .env.example .env
#
# .env 已在 .gitignore 中，不会被提交。请不要把自己的密钥发给任何人。
# ---------------------------------------------------------------------------

# ==== 服务监听 ====
# 默认只监听本机。要让局域网/反代访问才改成 0.0.0.0，
# 改成公网/局域网地址前，必须设置至少 16 位 PUBLIC_ACCESS_PASSWORD。
# 经反向代理对外提供服务时，即使这里仍是 127.0.0.1，也应设置密码并启用 HTTPS。
HOST=127.0.0.1
PORT=8000
PUBLIC_ACCESS_PASSWORD=

# ==== 向量化（必填）====
# 智谱开放平台密钥。没有它无法建立索引，也无法做语义检索。
# 申请地址：https://open.bigmodel.cn/
# 费用由你自己的账号承担：建库会对全部语料调用一次 embedding 接口。
ZHIPU_API_KEY=

# ==== 生成层（选填）====
# 不填则生成层只走智谱。没有智谱 Key 则无法建索引和检索。
DEEPSEEK_API_KEY=

# ---- 生成模型链（默认 deepseek -> zhipu，前者失败自动换后者）----
LLM_PROVIDER_CHAIN=deepseek,zhipu
LLM_MODEL_DEEPSEEK=deepseek-chat
LLM_MODEL_ZHIPU=glm-4-flash
# 注：智谱的 glm-5.3-flash / glm-4.5-flash 是推理模型，回答更细但要 10 秒以上；
#     规则问答用 glm-4-flash 更快，够用。

# ---- 向量（一般不用改）----
# 换了这个就要重新建索引；旧索引与新模型不兼容。
EMBED_MODEL=embedding-3
EMBED_DIMS=2048

# ==== 写权限令牌（公网部署必填）====
# 疑问库接口（/api/curated 的查看 / add / delete）可以把一段文本直接当「人工核定」
# 答案返回，绕过检索与生成层。未设置本变量时，写接口一律拒绝（fail-closed）。
# 只在你自己本机调试可以设成 dev；对公网提供服务必须设一个随机长串。
# 生成随机串：python -c "import secrets;print(secrets.token_urlsafe(32))"
CURATED_TOKEN=

# ==== 巡检免写日志令牌（选填）====
# 健康检查若带 X-Probe-Token 头，则不写用户查询日志。
# 未设置时，探针不会获得免记日志权限；不能复用 CURATED_TOKEN。
# 不要把该值放进前端或启动器。
PROBE_TOKEN=

# ==== 检索参数（一般不用改）====
# 返回候选条数。取 8 而不是 5：向量对"泛条款"（第 1 章飞盘精神那种）天然偏高，
# 正确条款常被挤到 6~8 位；多给几条交给生成层自己挑，比严卡 top5 更稳。
TOP_K=8
# 相关性闸门：最高余弦低于它 -> 判定「规则里没有」，不进生成层
MIN_SCORE=0.30

# ==== 多路融合（离线对照脚本用，线上检索不走这里）====
RRF_K=60
FUSE_DEPTH=20

# ==== 资源与预算上限（可选）====
# 同时答题请求数上限；超过的排队，超时返回 429/503。
MAX_CONCURRENT_REQUESTS=12
# 每日上游付费调用总次数上限（embedding + 生成 + 改写合计）。0 = 不限。
# 默认 2000 是按本项目线上的历史用量定的；自托管可调低。
DAILY_PAID_CALL_LIMIT=2000
